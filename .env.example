# Supabase — Project Settings > API
PIEGGI_SUPABASE_URL=https://seu-projeto.supabase.co
# Conexão Postgres direta usada pelo backend (Supabase → Connect → Session pooler, porta 5432, com a senha do banco)
PIEGGI_DATABASE_URL=postgresql://postgres.SEU_PROJECT_ID:SENHA_DO_BANCO@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
PIEGGI_SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role
PIEGGI_SUPABASE_PUBLISHABLE_KEY=sua-chave-publica-publishable-ou-anon
PIEGGI_SUPABASE_PROJECT_ID=seu-project-id

# Aplicação
PIEGGI_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
PIEGGI_APP_PORT=8080

# Frontend local (valor público, nunca coloque segredos em VITE_*)
VITE_PIEGGI_API_URL=

# Serviço fiscal interno
PIEGGI_SERVICO_FISCAL_URL=http://servico-fiscal:8081
PIEGGI_SERVICO_FISCAL_TOKEN=gere-um-segredo-longo-e-aleatorio
PIEGGI_ARMAZENAMENTO_FISCAL_DIR=/var/lib/pieggi/fiscal
# Chave Base64 de 32 bytes usada somente para cifrar a senha do A1.
PIEGGI_CHAVE_CIFRAGEM_FISCAL=base64-de-32-bytes
PIEGGI_PERMITIR_PRODUCAO_FISCAL=NAO
# Chave Base64 de 32 bytes para dados pessoais (CNPJ, telefone, PIX). Opcional: usa a fiscal se vazia.
PIEGGI_CHAVE_CIFRAGEM_DADOS=
